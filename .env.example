# Application
NODE_ENV=development
APP_NAME=TakeAPik
APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost:3000
DEV_TENANT_SLUG=
TRUST_PROXY=false

# Database
DATABASE_URL=postgresql://takeapik:change-me@127.0.0.1:5432/takeapik
DATABASE_SSL=false

# Sessions and secrets (generate each with: openssl rand -base64 32)
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_HASH_PEPPER=replace-with-a-different-random-secret
SESSION_TTL_HOURS=24

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=takeapik-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_CDN_URL=
MAX_UPLOAD_BYTES=15000000
MAX_IMAGE_WIDTH=1920

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TakeAPik <invites@example.com>

# Bootstrap only; disable after the first super-admin is created
SUPER_ADMIN_BOOTSTRAP_EMAIL=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
