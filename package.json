{
  "name": "takeapik",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant collaborative event photo albums",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap-super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "argon2": "^0.45.1",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
